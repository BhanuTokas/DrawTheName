# Phase 2 -- FTW Mode.
#
# Copy this file to ftw.yaml (gitignored) and set data.root and prue.checkpoint
# to this machine's local paths.
mode: ftw

data:
  root: /path/to/Datasets/FTW/ftw
  countries: [austria] # add more (e.g. [austria, france]) to enable the intra/inter-country confound check and concept-set comparison below
  split: val
  limit: null # only process the first N tiles; null for the full split
  # class_remap: {old_class_id: new_class_id}, per country -- corrects mask
  # label conventions that don't match the rest (0=background/1=field-interior/
  # 2=field-boundary). Observed: Kenya's val-split masks are presence-only
  # annotated (fields confirmed, background not), so unconfirmed area is
  # labeled 3 rather than 0 -- remap it to 255 (IGNORE_CLASS, excluded from
  # region extraction and pixel accuracy entirely) rather than forcing it
  # into any real class. Kenya's 1/2 already match field-interior/boundary,
  # no shift needed for those.
  # class_remap:
  #   kenya:
  #     3: 255

prue:
  repo: https://github.com/fieldsoftheworld/ftw-prue
  # this checkpoint is RGB-only (in_channels=3, temporal_options=window_a_rgb),
  # not the 4-band RGB+NIR input the original spec assumed -- see
  # drawthename/data/ftw.py and drawthename/segmentation_model.py::PRUEModel
  checkpoint: /path/to/ftw-baselines/models/prue-unet-logcoshdice-augs-efficientnetb3-winargb.ckpt

backbone:
  name: ViT-L-14 # primary; georsclip-ViT-B-32 as secondary
  device: cuda

regions:
  min_area_px: 64
  pad_px_min: 16
  pad_frac: 0.1
  error_rate_threshold: 0.5
  subdivision_size: null # FTW tiles are 256x256, well under CLIP's 224 native input plus padding -- no subdivision needed

clustering:
  k_min: 2
  k_max: 8

naming:
  bootstrap_resamples: 500
  cosine_threshold: 0.9 # per-resample cosine similarity needed to count as "agreeing"
  stability_threshold: 0.95
  residual_ratio_threshold: 0.1 # flag a direction in summary.md when ||deconfounded|| / ||raw|| falls below this -- concepts are ~arbitrary noise, not signal
  top_k_concepts: 10

ftw_compare:
  intra_inter_divergence_threshold: 0.5 # cosine similarity below this between intra-tile/inter-tile (or intra-country/inter-country) directions flags a likely confound
  concept_comparison_top_k: 20 # top-k used only for the intra-tile/intra-country/inter-country concept-set comparison (prevalent/tile_sensitive/domain_shift_candidates) -- wider than top_k_concepts above since intra-tile and intra-country pools are smaller/noisier, and a narrow top-k would manufacture spurious "differences" from sampling noise rather than real scope-dependence
  min_pair_region_count: 10 # per-(error_country, correct_country)-pair minimum region count on each side before that pair is trusted in the domain-shift-by-country-pair breakdown -- retrieve_concepts always returns a full top-k list regardless of sample size, so a country with only a handful of regions could otherwise produce a confident-looking concept list from essentially a single noisy sample

concept_bank: concept_banks/ftw_concepts.txt

plots:
  max_points_per_class: 3000 # stratified subsample cap before UMAP fitting; null/omit for no cap

output_dir: results/ftw
